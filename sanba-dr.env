# =============================================================================
# sanba-dr.env — parámetros de la migración DR de SANBA
#
# TODO lo que el script necesita se declara aquí o se DESCUBRE del clúster de
# producción en tiempo de ejecución (dominios, SCC, StorageClasses, pod y
# credenciales de la base de datos, registries). No hay nada incrustado en el
# código: cambiando este fichero se migra otra aplicación.
#
# Los valores marcados «autodescubierto» pueden dejarse vacíos.
# =============================================================================

# --- Acceso a los clústeres -------------------------------------------------
# Cada clúster tiene su propio login/token, por eso son dos kubeconfig.
#   KUBECONFIG=~/.kube/config-prod    oc login <api-prod>    --token=...
#   KUBECONFIG=~/.kube/config-preprod oc login <api-preprod> --token=...
KUBECONFIG_SRC="${KUBECONFIG_SRC:-$HOME/.kube/config-prod}"
KUBECONFIG_DST="${KUBECONFIG_DST:-$HOME/.kube/config-preprod}"

# --- Namespaces -------------------------------------------------------------
# Orden de procesamiento: configuración -> BD -> backend -> frontend.
NS_ORDER="location-resources sanba-data-persistence sanba-core sanba-gui"

# Sufijo que se añade en el clúster de contingencia.
DR_SUFFIX="-dr"

# Mapeo explícito origen:destino. Vacío = se deriva de NS_ORDER + DR_SUFFIX.
# Úsalo solo si algún namespace no sigue la regla del sufijo.
NS_MAP=""

# --- Base de datos (PostgreSQL 10-el8) --------------------------------------
DB_NS="sanba-data-persistence"

# Selector del pod de PostgreSQL. Vacío = autodescubierto por imagen en PROD.
DB_SELECTOR=""

# Migrar los datos con pg_dump/pg_restore.
DB_MIGRATE="true"

# false = pg_restore SIN --clean: no borra nada en la base de datos destino.
#         Si la BD destino ya tiene tablas, el script PREGUNTA si quieres
#         recargarla (o aborta y explica las opciones, si no hay terminal).
# true  = pg_restore --clean --if-exists: BORRA los objetos existentes en la BD
#         de pre-producción antes de restaurar, sin preguntar. Solo para repetir
#         el drill de forma desatendida.
#
# Para una recarga puntual no hace falta tocar esto: usa
#   ./sanba-dr-migrate.sh db-migrate --reload-db
# o la opción 7 de la consola, que te lo pregunta.
DB_RESTORE_CLEAN="false"

# Rol con el que se ejecuta pg_dump:
#   auto           = prueba por orden: usuario de la aplicación -> superusuario con
#                    contraseña del entorno del pod -> superusuario por socket local
#   app            = fuerza el usuario de la aplicación
#   postgres       = fuerza el superusuario usando DB_ADMIN_PASSWORD_ENV
#   postgres-local = fuerza el superusuario por el socket local del pod, sin
#                    contraseña (las imágenes de PostgreSQL de Red Hat lo permiten;
#                    por eso traen PGUSER=postgres en el entorno)
DB_DUMP_ROLE="auto"

# NOMBRE de la variable de entorno DEL POD que contiene la contraseña del
# superusuario. Es un nombre, NUNCA una contraseña: el valor se resuelve dentro
# del pod. Si aquí pones un secreto, acabará en sanba-dr.env y en migrate.log.
DB_ADMIN_PASSWORD_ENV="POSTGRESQL_ADMIN_PASSWORD"
DB_ADMIN_USER="postgres"

# Argumentos extra para pg_dump, p.ej. excluir un esquema ilegible: "-N service_catalog"
DB_DUMP_EXTRA_ARGS=""

# El volcado se escribe en /tmp DENTRO del pod y luego se descarga. Con "true"
# ese fichero temporal se deja en el pod (el script no borra nada en PROD).
DB_KEEP_REMOTE_DUMP="false"

# --- RBAC -------------------------------------------------------------------
# OpenShift crea solo los RoleBindings 'admin', 'system:deployers',
# 'system:image-builders' y 'system:image-pullers' en cada namespace nuevo.
# Con "false" (por defecto) no se migran los de producción: copiar el 'admin'
# daría permisos de administrador en contingencia a los dueños del proyecto de
# producción. Los RoleBindings propios de la aplicación sí se migran siempre.
MIGRATE_DEFAULT_ROLEBINDINGS="false"

# --- URLs de los componentes ------------------------------------------------
# El renombrado de namespace arregla las URLs INTERNAS de tipo
# <svc>.<namespace>.svc. Las EXTERNAS (las que pasan por una Route) no: un
# ConfigMap que apunte a https://sanba-gui-sanba-gui.apps.prod.example.com
# seguiría llamando a PRODUCCIÓN desde el entorno de contingencia.
#
# 'transform' construye out/<run>/url-map.tsv con tres fuentes, y aplica la
# coincidencia MÁS LARGA primero:
#   1. url-map.txt          — pares explícitos que tú declaras (máxima prioridad)
#   2. hosts de las Routes  — host en PROD -> host que tendrá la Route en DR
#   3. apps-domain          — .apps.<prod> -> .apps.<preprod>
#
# La sustitución alcanza a ConfigMaps, Secrets (solo valores base64 que son
# texto), env, args y command. El resultado auditado queda en reports/urls.txt.
URL_MAP_FILE="${URL_MAP_FILE:-url-map.txt}"

# false = no reescribir el apps-domain genérico; solo se sustituyen los hosts
#         que aparezcan en url-map.txt y los de las Routes migradas. Úsalo si
#         en tus ConfigMaps hay URLs de OTRAS aplicaciones del clúster de
#         producción que deben seguir apuntando a producción.
REWRITE_APPS_DOMAIN="${REWRITE_APPS_DOMAIN:-true}"

# Valores que el renombrado de namespace no debe tocar, porque son nombres de
# objeto y no de namespace. Una regla por línea: "CLAVE=valor" (recomendado),
# "CLAVE=*" o un literal suelto. 'transform' te marca los candidatos como
# AMBIGUO en reports/ns-rewrites.txt.
NS_REWRITE_SKIP_FILE="${NS_REWRITE_SKIP_FILE:-ns-rewrite-skip.txt}"

# --- Routes -----------------------------------------------------------------
# keep    = conservar el certificado embebido de la Route de PROD
# default = quitar cert/key/CA y dejar que el router use su wildcard  (recomendado:
#           el certificado de PROD no valida para el hostname de DR)
ROUTE_TLS_STRATEGY="default"

# Qué hacer con hosts custom (los que no siguen <route>-<ns>.<apps-domain>)
# generate = borrar spec.host y dejar que el router asigne uno
# map      = leer route-map.txt  ("<host-origen> <host-destino>" por línea)
ROUTE_CUSTOM_STRATEGY="generate"
ROUTE_MAP_FILE="route-map.txt"

# Path que se consulta al validar cada URL
HEALTH_PATH="/"
# Códigos HTTP que se consideran "la app responde"
HEALTH_OK_CODES="200 201 204 301 302 303 307 308 401 403"

# --- Registry para el mirror de imágenes ------------------------------------
# Solo se usa para GENERAR los comandos de skopeo en out/<run>/mirror-commands.sh.
# El script nunca mirrorea por su cuenta.
MIRROR_REGISTRY=""

# Verificación del certificado TLS de los registries internos.
#
# "false" (por defecto): skopeo copia con --src-tls-verify=false y
# --dest-tls-verify=false, y 'oc registry login' con --insecure. Es lo práctico
# aquí, porque los registries internos usan un certificado firmado por la CA del
# clúster que el host no reconoce.
#
# Para volver a verificar, pon "true" y confía antes en la CA del router:
#   oc get secret -n openshift-ingress-operator router-ca \
#     -o jsonpath='{.data.tls\.crt}' | base64 -d \
#     | sudo tee /etc/pki/ca-trust/source/anchors/ocp-router-ca.crt
#   sudo update-ca-trust extract
MIRROR_TLS_VERIFY="false"

# --- Almacenamiento ---------------------------------------------------------
# Remapeo de StorageClass si difieren entre clústeres: "origen:destino origen2:destino2"
# Vacío = se usan las mismas que en PROD; el preflight avisa si no existen.
STORAGE_CLASS_MAP=""

# --- Timeouts y reintentos --------------------------------------------------
ROLLOUT_TIMEOUT="600s"
PVC_BOUND_TIMEOUT="300"
# Sonda de URLs: una primera pasada inmediata sobre todas las rutas y luego
# solo se reintentan las que fallaron.
ROUTE_PROBE_RETRIES="6"
ROUTE_PROBE_INTERVAL="10"
ROUTE_PROBE_TIMEOUT="15"

# --- Comportamiento ---------------------------------------------------------
# Saltar el chequeo de skew de versión del cliente oc (NO recomendado)
SKIP_VERSION_CHECK="false"

# --- Consola interactiva (sanba-dr.sh) --------------------------------------
# URL de la API de cada clúster. Si se dejan vacías, la consola las pide al
# iniciar sesión. Aquí NUNCA van tokens: se piden por teclado y se guardan solo
# en el kubeconfig correspondiente (con permisos 600).
SRC_API="${SRC_API:-}"          # producción (solo lectura)
DST_API="${DST_API:-}"          # pre-producción / contingencia

# true = 'oc login' con --insecure-skip-tls-verify. Necesario cuando el
# certificado de la API está firmado por una CA que el host no reconoce.
LOGIN_INSECURE="true"
