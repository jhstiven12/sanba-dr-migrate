#!/usr/bin/env bash
# oc simulado para tests/smoke.sh. No habla con ningún clúster.
ALL="$*"; last="${@: -1}"
case " $ALL " in
  *" whoami --show-server "*) [[ "$KUBECONFIG" == *config-prod ]] && echo "https://api.prod:6443" || echo "https://api.preprod:6443"; exit 0 ;;
  *" whoami "*)   echo "system:serviceaccount:test:migrator"; exit 0 ;;
  *" version "*)  echo '{"openshiftVersion":"4.18.5","clientVersion":{"gitVersion":"v4.18.5"},"releaseClientVersion":"4.18.5"}'; exit 0 ;;
  *" auth can-i "*) echo yes; exit 0 ;;
  *" adm policy "*|*" apply "*|*" patch "*|*" rollout status "*) exit 0 ;;
esac
# scripts ejecutados dentro del pod de PostgreSQL
case "$last" in
  *"printf '%s"*)          printf 'sanba\037clave\037sanba\037'; exit 0 ;;
  *"has_table_privilege"*) [[ "$last" == *"psql -U postgres"* ]] && exit 0 || { echo "service_catalog.seq_x  [secuencia]"; exit 0; } ;;
  *"SELECT 1;"*)           [[ "$last" == *"psql -U postgres"* ]] && { echo 1; exit 0; } || exit 0 ;;
  *"count(*) FROM information_schema.tables"*) echo "${MOCK_DB_TABLES:-0}"; exit 0 ;;
  *"query_to_xml"*)        printf 'public.clientes 120\npublic.movimientos 4500\n'; exit 0 ;;
  *"pg_dump"*|*"pg_restore"*|*"mkdir -p"*|*"rm -rf"*) exit 0 ;;
esac
if [[ "$ALL" == *"rsync"* ]]; then
  for a in "$@"; do [[ "$a" == */ && "$a" != *:* ]] && dest="$a"; done
  [[ -n "${dest:-}" ]] && { mkdir -p "$dest"; echo "DUMP-SIMULADO" > "$dest/sanba.dump"; }
  exit 0
fi
# --- inventario simulado de los namespaces de contingencia -------------------
# Sirve para probar la validación de la asociación entre namespaces sin clúster.
ns=""
prev=""
for a in "$@"; do [[ "$prev" == "-n" ]] && ns="$a"; prev="$a"; done

if [[ "$ALL" == *"get service -o json"* ]]; then
  case "$ns" in
    location-resources-dr)     echo '{"items":[{"metadata":{"name":"config"}},{"metadata":{"name":"core-alias"}}]}' ;;
    sanba-core-dr)             echo '{"items":[{"metadata":{"name":"sanba-core"}}]}' ;;
    sanba-gui-dr)              echo '{"items":[{"metadata":{"name":"sanba-gui"}}]}' ;;
    sanba-data-persistence-dr) echo '{"items":[{"metadata":{"name":"postgresql"}}]}' ;;
    *)                         echo '{"items":[]}' ;;
  esac
  exit 0
fi
if [[ "$ALL" == *"get endpoints -o json"* ]]; then
  case "$ns" in
    location-resources-dr)     echo '{"items":[{"metadata":{"name":"config"},"subsets":[{"addresses":[{"ip":"10.1.0.1"}]}]}]}' ;;
    sanba-core-dr)             echo '{"items":[{"metadata":{"name":"sanba-core"},"subsets":[{"addresses":[{"ip":"10.1.0.2"}]}]}]}' ;;
    sanba-gui-dr)              echo '{"items":[{"metadata":{"name":"sanba-gui"},"subsets":[{"addresses":[{"ip":"10.1.0.3"}]}]}]}' ;;
    sanba-data-persistence-dr) echo '{"items":[{"metadata":{"name":"postgresql"},"subsets":[{"addresses":[{"ip":"10.1.0.4"}]}]}]}' ;;
    *)                         echo '{"items":[]}' ;;
  esac
  exit 0
fi
if [[ "$ALL" == *"get rolebinding -o json"* ]]; then
  [[ "$ns" == "location-resources-dr" ]] \
    && echo '{"items":[{"metadata":{"name":"core-can-read"},"roleRef":{"name":"config-reader"},"subjects":[{"kind":"ServiceAccount","name":"sanba-core-sa","namespace":"sanba-core-dr"}]}]}' \
    || echo '{"items":[]}'
  exit 0
fi
if [[ "$ALL" == *"get networkpolicy -o json"* ]]; then
  [[ "$ns" == "location-resources-dr" ]] \
    && echo '{"items":[{"metadata":{"name":"allow-app"},"spec":{"ingress":[{"from":[{"namespaceSelector":{"matchLabels":{"kubernetes.io/metadata.name":"sanba-core-dr"}}}]}]}}]}' \
    || echo '{"items":[]}'
  exit 0
fi
if [[ "$ALL" == *"get configmap,secret,deployment"* ]]; then
  case "$ns" in
    location-resources-dr) echo '{"items":[{"kind":"ConfigMap","metadata":{"name":"endpoints"},"data":{"core":"http://sanba-core.sanba-core-dr.svc:8080","db":"postgresql.sanba-data-persistence-dr.svc"}}]}' ;;
    sanba-core-dr)         echo '{"items":[{"kind":"ConfigMap","metadata":{"name":"sanba-core-config"},"data":{"LOC_URL":"http://config.location-resources-dr.svc/api","GUI":"http://sanba-gui.sanba-gui-dr.svc:8080"}}]}' ;;
    sanba-gui-dr)          echo '{"items":[{"kind":"Deployment","metadata":{"name":"sanba-gui"},"spec":{"template":{"spec":{"containers":[{"name":"web","env":[{"name":"API","value":"http://sanba-core.sanba-core-dr.svc:8080"}]}]}}}}]}' ;;
    *)                     echo '{"items":[]}' ;;
  esac
  exit 0
fi
if [[ "$ALL" == *"get deployment,deploymentconfig,statefulset -o json"* ]]; then
  case "$ns" in
    sanba-core-dr) echo '{"items":[{"kind":"Deployment","metadata":{"name":"sanba-core"}},{"kind":"DeploymentConfig","metadata":{"name":"sanba-core-batch"}}]}' ;;
    sanba-gui-dr)  echo '{"items":[{"kind":"Deployment","metadata":{"name":"sanba-gui"}}]}' ;;
    *)             echo '{"items":[]}' ;;
  esac
  exit 0
fi
if [[ "$ALL" == *"get sa sanba-core-sa"* ]]; then exit 0; fi

[[ "$ALL" == *"get pods -o json"* ]] && { echo '{"items":[{"metadata":{"name":"pg-1-abcde"},"status":{"phase":"Running","containerStatuses":[{"ready":true}]},"spec":{"containers":[{"image":"registry.redhat.io/rhel8/postgresql-10"}]}}]}'; exit 0; }
[[ "$ALL" == *"get pvc -o json"* ]] && { echo '{"items":[{"metadata":{"name":"data"},"status":{"phase":"Bound"}}]}'; exit 0; }
[[ "$ALL" == *"get sa default -o json"* ]] && { echo '{"imagePullSecrets":[{"name":"default-dockercfg-zzzzz"}]}'; exit 0; }
[[ "$ALL" == *"-o json"* ]]     && { echo '{"items":[]}'; exit 0; }
[[ "$ALL" == *"-o jsonpath"* ]] && { echo ""; exit 0; }
exit 0
