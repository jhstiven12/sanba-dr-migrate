#!/usr/bin/env bash
# oc simulado para tests/smoke.sh. No habla con ningún clúster.
ALL="$*"; last="${@: -1}"
case " $ALL " in
  *" whoami --show-server "*) [[ "$KUBECONFIG" == *config-prod ]] && echo "https://api.prod:6443" || echo "https://api.preprod:6443"; exit 0 ;;
  *" whoami "*)   echo "system:serviceaccount:test:migrator"; exit 0 ;;
  *" version "*)  echo '{"openshiftVersion":"4.18.5","clientVersion":{"gitVersion":"v4.18.5"},"releaseClientVersion":"4.18.5"}'; exit 0 ;;
  *" auth can-i "*) echo yes; exit 0 ;;
  *" adm policy "*|*" apply "*|*" patch "*|*" rollout status "*) exit 0 ;;
esac
# scripts ejecutados dentro del pod de PostgreSQL
case "$last" in
  *"printf '%s"*)          printf 'sanba\037clave\037sanba\037'; exit 0 ;;
  *"has_table_privilege"*) [[ "$last" == *"psql -U postgres"* ]] && exit 0 || { echo "service_catalog.seq_x  [secuencia]"; exit 0; } ;;
  *"SELECT 1;"*)           [[ "$last" == *"psql -U postgres"* ]] && { echo 1; exit 0; } || exit 0 ;;
  *"count(*) FROM information_schema.tables"*) echo 0; exit 0 ;;
  *"query_to_xml"*)        printf 'public.clientes 120\npublic.movimientos 4500\n'; exit 0 ;;
  *"pg_dump"*|*"pg_restore"*|*"mkdir -p"*|*"rm -rf"*) exit 0 ;;
esac
if [[ "$ALL" == *"rsync"* ]]; then
  for a in "$@"; do [[ "$a" == */ && "$a" != *:* ]] && dest="$a"; done
  [[ -n "${dest:-}" ]] && { mkdir -p "$dest"; echo "DUMP-SIMULADO" > "$dest/sanba.dump"; }
  exit 0
fi
[[ "$ALL" == *"get pods -o json"* ]] && { echo '{"items":[{"metadata":{"name":"pg-1-abcde"},"status":{"phase":"Running","containerStatuses":[{"ready":true}]},"spec":{"containers":[{"image":"registry.redhat.io/rhel8/postgresql-10"}]}}]}'; exit 0; }
[[ "$ALL" == *"get pvc -o json"* ]] && { echo '{"items":[{"metadata":{"name":"data"},"status":{"phase":"Bound"}}]}'; exit 0; }
[[ "$ALL" == *"get sa default -o json"* ]] && { echo '{"imagePullSecrets":[{"name":"default-dockercfg-zzzzz"}]}'; exit 0; }
[[ "$ALL" == *"-o json"* ]]     && { echo '{"items":[]}'; exit 0; }
[[ "$ALL" == *"-o jsonpath"* ]] && { echo ""; exit 0; }
exit 0
